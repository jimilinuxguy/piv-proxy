# Generic CAC/PIV gateway. Supply trusted CA bundles, CRLs and allowed policies.
PIV_STRICT=true
# Required in strict mode. Comma-separated certificate policy OIDs approved by your organization.
REQUIRED_POLICY_OIDS=
PIV_ISSUER_PATH=/app/pki/issuer.pem
PIV_CRL_PATH=/app/pki/issuer.crl
# Optional directory of issuer-specific .crl/.der files; overrides single CRL if present.
PIV_CRL_DIRECTORY=/app/pki/crls
# Optional, for manual CRL refresh with scripts/update-crl.py
PIV_CRL_URL=
PIV_CRL_ALLOWED_HOSTS=

# Comma-separated exact HTTPS origins allowed for post-auth redirects.
# To share a host-only cookie, use the same hostname (ports may differ).
PIV_CALLBACK_ALLOWED_ORIGINS=https://localhost:8443
