# Generic CAC/PIV gateway. Supply trusted CA bundles, CRLs and allowed policies.
PIV_STRICT=true
# Required in strict mode. Comma-separated certificate policy OIDs approved by your organization.
REQUIRED_POLICY_OIDS=
PIV_ISSUER_PATH=/app/pki/issuer.pem
PIV_CRL_PATH=/app/pki/issuer.crl
# Optional directory of issuer-specific .crl/.der files; overrides single CRL if present.
PIV_CRL_DIRECTORY=/app/pki/crls
# Optional, for manual CRL refresh with scripts/update-crl.py
PIV_CRL_URL=
PIV_CRL_ALLOWED_HOSTS=

# Comma-separated exact HTTPS origins allowed for post-auth redirects.
# To share a host-only cookie, use the same hostname (ports may differ).
PIV_CALLBACK_ALLOWED_ORIGINS=https://localhost:8443

# Required for internal server-to-server session introspection; use a long random secret.
# Example generation: openssl rand -hex 32
PIV_VALIDATION_API_KEY=

# Optional remote-application OIDC. Disabled by default.
OIDC_ENABLED=false
OIDC_ISSUER=https://localhost:8443
# JSON map of public client IDs to arrays of exact HTTPS redirect URIs.
OIDC_CLIENTS_JSON={"demo-client":["https://localhost:3000/oidc/callback"]}
# Generate oidc/private.pem locally (never commit it).

# Deployment origins (use real trusted HTTPS DNS names outside localhost).
PIV_MTLS_ORIGIN=https://localhost:8444
PIV_DEFAULT_RETURN_URL=https://localhost:8443/app/
# Optional explicitly provisioned fingerprint -> persistent subject mapping.
# Never infer a permanent identity from the display name.
PIV_SUBJECT_MAP_JSON={}
# Structured client registration supports:
# OIDC_CLIENTS_JSON={"piv-demo":{"redirect_uris":["https://localhost:8445/callback"],"post_logout_redirect_uris":["https://localhost:8445/"],"scopes":["openid","profile"],"token_endpoint_auth_method":"none"}}
# Confidential clients may use token_endpoint_auth_method=client_secret_post and client_secret.
