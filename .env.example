# Strict local NASA PIV Authentication profile (development demonstration only).
PIV_STRICT=true
REQUIRED_POLICY_OIDS=2.16.840.1.101.3.2.1.3.13
NASA_ISSUER=NASA Operational CA
PIV_CRL_PATH=/app/pki/nasa-leaf.crl
PIV_ISSUER_PATH=/app/pki/nasa-operational.pem
# Issuer CRL distribution point observed on NASA Operational CA PIV-auth certificates.
# Override if your actual certificate publishes a different complete CRL.
PIV_CRL_URL=http://hc.nasa.gov/combinedCRL5.crl
